@page
@model FruitAndVegApp.ListModel
<h1 class="h1"> Welcome to my fruit and veg list </h1>
<table class="table table-striped gap-2">
    <thead>
        <tr>

            <th>
                Name
            </th>
            <th>
                Stars
            </th>
            <th>
                Options
            </th>

        </tr>
    </thead>
    <tbody>
        @{


            foreach (FiveADay s in Model.FruitAndVegList)
            {
                string starString = "";
                for (int i = 0; i < s.Stars; i++)
                {
                    starString += "\u2B50";
                }
                <tr>
                    <td style="width: 100%;"> @s.Name </td>
                    <td style="width: 110px;"> @starString </td>
                    <td>
                        <div class="d-flex gap-2">
                            <form method="get" asp-Page="Edit" asp-route-id="@s.Id">
                                <input type="hidden" name="Id" value="@s.Id" />
                                <button class="btn btn-success"> Edit </button>
                            </form>
                            <form method="post" asp-page="Delete" asp-route-id="@s.Id"> <button class="btn btn-danger"
                                                                                                    id="DeleteButton" name="@s.Name"> Delete </button> </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>